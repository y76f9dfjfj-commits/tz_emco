# Настройки процессора виртуальных очередей (python -m vqueue.processor_main).
# Значения ниже — значения по умолчанию; секретов здесь нет.

# Адреса брокеров Kafka. Брокер стенда docker compose с хоста — 127.0.0.1:9094.
KAFKA_BOOTSTRAP=localhost:9092
# Путь к TOML-конфигурации площадки.
SITE_CONFIG=config/site.toml
# Идентификатор площадки: ключ снимка состояния и часть transactional.id.
SITE_ID=site-1
# Идентификатор экземпляра процессора: часть transactional.id
# (vqueue-processor-<SITE_ID>-<INSTANCE_ID>) и, только если задан явно, group.instance.id
# (статическое членство в консьюмер-группе). По умолчанию — имя хоста, членство динамическое.
# Значение должно быть стабильным (переживать перезапуск — например, имя пода StatefulSet)
# и уникальным: два живых экземпляра с одним INSTANCE_ID фенсят друг друга.
# Статическое членство ускоряет восстановление после падения, но SIGTERM не освобождает
# партицию: резервный экземпляр с другим id получит её лишь через session.timeout.ms.
# INSTANCE_ID=
# Консьюмер-группа процессора. По умолчанию vqueue-processor-<SITE_ID>.
CONSUMER_GROUP=vqueue-processor-site-1
# Порт HTTP health-check (/health/live, /health/ready), 1..65535.
HEALTH_PORT=8080
# Уровень логирования: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO
